# Secrets & env
.env
secrets/
*.token.json
youtube_token.json

# Generated media & queue
data/pending/*
data/published/*
data/work/*
!data/**/.gitkeep
# Reserve bank: the recipes (meta.json) ARE tracked so they persist between
# cloud runs, but a recipe's re-rendered clip/scratch is local-only.
data/reserve/**/*.mp4
data/reserve/**/*.mp3
data/reserve/**/*.m4a
data/reserve/**/work/
data/reserve/**/*.ass
# control/log files (kept local; never commit)
data/PAUSED
data/auto.log
# The spend ledger stays LOCAL — it accumulates video IDs + costs and we don't
# want it published. View it locally with `python -m socialbot.cli costs`.
data/costs.jsonl
# Dedup memory (covered topics, used footage IDs, last voice). Kept LOCAL and
# untracked: it's live, ever-growing state, so tracking it made every run a dirty
# working tree — and a stray `git restore data/` would silently wipe the memory
# and let the engine re-make a story it already covered (it did: the ISS leak).
# Persisting it across machines/CI is a separate concern (artifact cache, not git).
data/used_topics.json
data/used_broll.json
data/used_commons.json
data/used_nasa.json
data/last_voice.txt

# Local editor/agent settings
.claude/settings.local.json
.wrangler/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
