# Secrets & env
.env
secrets/
*.token.json
youtube_token.json

# Generated media & queue
data/pending/*
data/published/*
data/work/*
!data/**/.gitkeep
# Reserve bank: the recipes (meta.json) ARE tracked so they persist between
# cloud runs, but a recipe's re-rendered clip/scratch is local-only.
data/reserve/**/*.mp4
data/reserve/**/*.mp3
data/reserve/**/*.m4a
data/reserve/**/work/
data/reserve/**/*.ass
# control/log files (kept local; never commit)
data/PAUSED
data/auto.log
# The spend ledger stays LOCAL — it accumulates video IDs + costs and we don't
# want it published. View it locally with `python -m socialbot.cli costs`.
data/costs.jsonl
# NOTE: data/used_*.json and data/last_voice.txt ARE tracked (harmless footage
# IDs / voice name) so the cloud job can persist dedup state between runs.

# Local editor/agent settings
.claude/settings.local.json
.wrangler/

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
