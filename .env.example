# ── Google AI Studio (Gemini) ──────────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Dynamic model split: the quality model writes the script/story; the cheaper
# model handles the mechanical grounded calls (trend discovery + fact-check).
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CALLS_MODEL=gemini-2.5-flash-lite
# Used automatically if a model is overloaded (503) or rate-limited (429).
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Spend tracking estimates each Gemini call's cost from list prices. Override
# them here (USD per 1M tokens) if your pricing differs. Free-tier usage is $0;
# this only estimates what billed usage would cost. See `socialbot.cli costs`.
# GEMINI_PRICES={"gemini-2.5-flash":{"input":0.30,"output":2.50},"gemini-2.5-flash-lite":{"input":0.10,"output":0.40}}

# ── Stock b-roll (free) ────────────────────────────────────────────────────
# Free API key at https://www.pexels.com/api/  (leave blank to use a generated
# gradient background instead of real footage)
PEXELS_API_KEY=

# ── Voiceover (edge-tts, free, no key) ─────────────────────────────────────
# Voices: run `python -m socialbot.cli voices` to list.
# TTS_VOICES = a pool rotated per video (never repeats the previous one) so the
# channel doesn't always sound the same. Leave TTS_VOICES blank to use a single
# fixed TTS_VOICE instead.
TTS_VOICES=en-US-AndrewMultilingualNeural,en-US-BrianMultilingualNeural,en-US-ChristopherNeural,en-US-EricNeural,en-GB-RyanNeural,en-AU-WilliamNeural
TTS_VOICE=en-US-AndrewMultilingualNeural

# ── Content settings ───────────────────────────────────────────────────────
# Comma-separated niche/topics to bias trend discovery (blank = general news)
CONTENT_NICHE=AI and emerging technology, space and astronomy, UFOs/UAPs and the search for extraterrestrial life

# Topics matching these keywords are "speculative" — inherently unverifiable
# subject matter. In `auto` mode they're allowed to publish on a 'needs_review'
# fact-check verdict (the claim can't be confirmed), but a 'rejected' (debunked)
# verdict still blocks them. All other topics still require a clean 'ok'.
SPECULATIVE_KEYWORDS=ufo,ufos,uap,uaps,alien,aliens,extraterrestrial,flying saucer,close encounter,abduction,roswell,paranormal,cryptid
# The narrator's voice/personality — shapes how scripts are written
CONTENT_TONE=clear, punchy, plain-spoken explainer; smart and factual but neutral — no hype, no jokes
# Target clip length in seconds (v2 mini-docs run 30-45s; MIN/MAX bound the
# per-video length jitter used as a retention experiment-arm).
CLIP_SECONDS=38
CLIP_SECONDS_MIN=30
CLIP_SECONDS_MAX=45

# ── Branding (corner logo bug + brief logo outro card; NO front intro) ──────
BRANDING_ENABLED=true
LOGO_PATH=assets/oddjob-logo.png
LOGO_OPACITY=0.85
LOGO_SCALE_W=150
ENDCARD_SECONDS=1.0

# ── Music bed (off until you drop a monetization-safe track in MUSIC_DIR) ───
MUSIC_ENABLED=false
MUSIC_DIR=assets/music
MUSIC_VOLUME=0.08

# ── v2 daily tournament + native scheduling (Phase 3) ───────────────────────
# One daily batch mines CONCEPTS_N ideas, scores down to DEVELOP_N, develops
# those, keeps FINALISTS_N, fact-checks them, then posts the best POSTS_PER_DAY
# and banks the rest as recipes. Defaults fit the free tier (~20 Flash + ~20
# Flash-Lite requests/day) at ~32 calls/run. BATCH_CALL_CEILING is a safety stop.
POSTS_PER_DAY=3
CONCEPTS_N=15
DEVELOP_N=10
FINALISTS_N=4
BATCH_CALL_CEILING=36
# A banked recipe must clear fact-check AND score at/above this judge floor (0-100).
BANK_SCORE_FLOOR=60
# Reserve bank: keep at most this many recipes; re-fact-check any older than
# RESERVE_REVET_DAYS before re-rendering them (1 grounded call, off the daily budget).
RESERVE_MAX=30
RESERVE_REVET_DAYS=7
# Native YouTube publishAt: the daily winners upload PRIVATE and auto-publish at
# these staggered times (one slot per post), interpreted in SCHEDULE_TZ.
PUBLISH_TIMES=14:00,19:00,00:00
SCHEDULE_TZ=UTC

# ── YouTube Data API ───────────────────────────────────────────────────────
# OAuth client secrets JSON downloaded from Google Cloud Console.
YOUTUBE_CLIENT_SECRETS=secrets/youtube_client_secret.json
# Where the OAuth token is cached after first login.
YOUTUBE_TOKEN_FILE=secrets/youtube_token.json
# unlisted | private | public  (start with unlisted/private while testing)
YOUTUBE_PRIVACY=private

# ── Facebook Page (Graph API) ──────────────────────────────────────────────
# A long-lived Page access token, and the Page's numeric ID.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
